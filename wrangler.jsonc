{
  // Maktab marketing site: static files served by Cloudflare Workers (no Worker code).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maktab-marketing",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./public",
    // /features serves features.html; unknown paths get 404.html with a 404 status
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "maktab-marketing.luminarysolutions.ai", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": true
}
