{
  // Maktab marketing site: static pages plus two form endpoints (/api/contact, /api/waitlist).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maktab-marketing",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // only the API runs the Worker; every page and file is served straight from the assets
    "run_worker_first": ["/api/*"],
    // /features serves features.html; unknown paths get 404.html with a 404 status
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "maktab-marketing.luminarysolutions.ai", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    // where form submissions are emailed; it must be a verified address in Cloudflare Email Routing
    // (Email Routing > Destination addresses), which makes these sends free on every plan
    "CONTACT_TO": "abdullah.siddiki@darulislah.org",
    // sender; the domain must be onboarded to Cloudflare Email Sending (records go under cf-bounce)
    "MAIL_FROM": "forms@luminarysolutions.ai"
  },
  "send_email": [
    { "name": "EMAIL", "allowed_destination_addresses": ["abdullah.siddiki@darulislah.org"] }
  ],
  // every submission is kept here too, so nothing is lost if an email fails
  "d1_databases": [
    { "binding": "DB", "database_name": "maktab-marketing-forms", "database_id": "04a2991c-157a-4658-b3c3-7b2ddb20492d", "migrations_dir": "migrations" }
  ],
  // at most 5 submissions per visitor per minute
  "ratelimits": [
    { "name": "FORM_LIMIT", "namespace_id": "4171", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
